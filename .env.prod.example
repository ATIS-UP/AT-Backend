# ===== Database (PostgreSQL en Dokploy) =====
# Dokploy genera esta URL automáticamente al crear el servicio Database
DATABASE_URL=postgresql://user:password@postgres:5432/at-db

# ===== JWT =====
JWT_SECRET_KEY=genera_una_clave_segura_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Fernet =====
FERNET_KEY=genera_un_fernet_key_aqui

# ===== App =====
APP_NAME=Sistema de Alertas Tempranas
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGIN=https://proyecto.duckdns.org

# ===== Rate Limiting =====
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ===== Storage =====
# "local" para desarrollo, "s3" para producción con Minio
STORAGE_BACKEND=s3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=tu_contraseña_minio
MINIO_BUCKET=at-artefactos
MINIO_USE_SSL=false

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
